# GovLens Environment Configuration

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/govlens

# ─── Redis (for BullMQ job queue) ─────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── RPC Endpoints ────────────────────────────────────────────
# At least one is required. Alchemy, Infura, or other providers.
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# ─── LLM Provider (one required) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Model Configuration ─────────────────────────────────────
# GOVLENS_MODEL=claude-sonnet-4-20250514
# GOVLENS_MAX_TOKENS=2048

# ─── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Etherscan API Keys (for source verification) ─────────────
# ETHERSCAN_API_KEY=xxx
# ARBISCAN_API_KEY=xxx
# OPTIMISTIC_ETHERSCAN_API_KEY=xxx
# BASESCAN_API_KEY=xxx
# POLYGONSCAN_API_KEY=xxx
