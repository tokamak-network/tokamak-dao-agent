# Ethereum RPC (required for on-chain queries)
ALCHEMY_RPC_URL=

# Etherscan API (required for fetching contract sources)
ETHERSCAN_API_KEY=

# LiteLLM / OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=
CHAT_MODEL=gpt-5.2

# Anthropic API (optional, for Claude models)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# MCP SSE Server (optional, defaults shown)
# MCP_SSE_PORT=3001
# MCP_API_KEY=

# ElizaOS (set automatically in docker-compose / fly.io)
# ELIZAOS_URL=http://localhost:3000

# Reown (WalletConnect) Project ID — get from https://cloud.reown.com
# Required for wallet connection in Forum
# VITE_REOWN_PROJECT_ID=

# CORS allowed origins (comma-separated, optional — defaults to "*" if not set)
# ALLOWED_ORIGINS=https://tokamak-dao-agent.fly.dev,http://localhost:5173

# Web server port (optional, default 3333)
# PORT=3333

# Agent Wallets (generate with: bun run generate-wallets >> .env)
# AGENT_ALPHA_PK=0x...
# AGENT_BETA_PK=0x...
# AGENT_GAMMA_PK=0x...
# AGENT_DELTA_PK=0x...
